From 05353e7e292a58970807f9b7d180d6c50573a52f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 8 Oct 2026 12:02:43 +0000
Subject: [PATCH] Run CI with an S3Mock service container on master

The workflow triggered only on main while the default branch is
master, ran on Windows and macOS where service containers are not
available, and had no S3 server. Use ubuntu-latest with an
adobe/s3mock service container on port 19100, Node 24.x and 22.x.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01LaHppcejXbSsAH4BZXNsjV
---
 .github/workflows/build.yml | 28 +++++++++++++++++++++++-----
 1 file changed, 23 insertions(+), 5 deletions(-)

diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index f67cea6..299e33e 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -2,25 +2,43 @@ name: build
 
 on:
   push:
-    branches: [main]
+    branches: [master, main]
   pull_request:
-    branches: [main]
+    branches: [master, main]
 
 jobs:
   build:
-    timeout-minutes: 6
+    timeout-minutes: 10
     strategy:
       fail-fast: false
       matrix:
-        os: [ubuntu-latest, windows-latest, macos-latest]
         node-version: [24.x, 22.x]
-    runs-on: ${{ matrix.os }}
+    runs-on: ubuntu-latest
+
+    services:
+      s3:
+        image: adobe/s3mock:5.2
+        env:
+          COM_ADOBE_TESTING_S3MOCK_STORE_INITIAL_BUCKETS: test-bucket
+        ports:
+          - 19100:9090
+        options: >-
+          --health-cmd "wget -q -O /dev/null http://localhost:9090/"
+          --health-interval 5s
+          --health-timeout 5s
+          --health-retries 20
+
+    env:
+      SENECA_TEST_S3_ENDPOINT: http://127.0.0.1:19100
+      SENECA_TEST_S3_BUCKET: test-bucket
+
     steps:
       - uses: actions/checkout@v4
       - name: Use Node.js ${{ matrix.node-version }}
         uses: actions/setup-node@v4
         with:
           node-version: ${{ matrix.node-version }}
+          cache: npm
       - run: npm install
       - run: npm run build --if-present
       - run: npm test
-- 
